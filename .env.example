# Vela uses one env file per app. This file only documents how they fit together.
#
#   backend/.env   <- copy from backend/.env.example (secrets live here only)
#   frontend/.env  <- copy from frontend/.env.example (VITE_* values are PUBLIC)
#
# Minimum local setup:
#   backend:  MONGODB_URI, JWT_ACCESS_SECRET, CLIENT_ORIGINS=http://localhost:5173, APP_URL=http://localhost:5173
#   payments: RAZORPAY_KEY_ID=rzp_test_..., RAZORPAY_KEY_SECRET=..., RAZORPAY_WEBHOOK_SECRET=...
#   frontend: VITE_API_URL=/api/v1 (Vite proxies /api to http://localhost:4000)
#
# Never commit real .env files. Never put backend secrets in VITE_* variables.
