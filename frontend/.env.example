# Vela frontend configuration (copy to frontend/.env).
# Only VITE_* variables reach the browser. NEVER put secrets here:
# the Razorpay key secret, webhook secret, JWT secret and database URI stay on the backend.

# Base URL of the API. Keep "/api/v1" when the API is served from the same origin
# (Vite dev proxy locally, or a Vercel rewrite in production). Otherwise use the full
# URL, e.g. https://vela-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Where the Vite dev server forwards /api requests (development only)
VITE_DEV_API_PROXY=http://localhost:4000
