# ─────────────────────────────────────────────────────────────
# Vela backend configuration. Copy to backend/.env and fill in.
# Never commit backend/.env. Every value here is validated at startup.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set to the number of proxies in front of the API (1 on Render/Railway/Heroku) so req.ip and rate limits are correct.
TRUST_PROXY=0

# MongoDB. Use a replica set (Atlas, Docker with --replSet, or `npm run db:dev`) for transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/vela?replicaSet=rs0
# auto = detect; on = require transactions; off = never use them (atomic updates + compensation only)
MONGODB_TRANSACTIONS=auto

# Frontend origins allowed by CORS and the CSRF origin check (comma-separated, no trailing slash)
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the storefront (used in password-reset and order emails)
APP_URL=http://localhost:5173

# Authentication. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# Refresh-token cookie. Development over http: COOKIE_SECURE=false, COOKIE_SAMESITE=lax.
# Production behind HTTPS on the same site (Vercel rewrite): true / lax.
# Production with frontend and API on different sites: true / none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Razorpay TEST MODE (Dashboard -> switch to Test Mode -> Account & Settings -> API Keys).
# The key id must start with rzp_test_; live keys are refused unless RAZORPAY_ALLOW_LIVE_KEYS=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook (Dashboard -> Webhooks), events: payment.captured,
# payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE_KEYS=false

# Commerce rules. Money is in the smallest currency unit (paise): 50000 = ₹500.
CURRENCY=INR
TAX_RATE=0.08
SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=0
ORDER_RESERVATION_MINUTES=30
MAX_CART_ITEM_QUANTITY=10
LOW_STOCK_THRESHOLD=5
PAGINATION_DEFAULT_LIMIT=12
PAGINATION_MAX_LIMIT=48

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=600

# Email (optional). Without SMTP, password-reset links are printed to the server log in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Vela <no-reply@vela.local>

# Image uploads via Cloudinary (optional). Without these, admins paste existing https image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vela/products
MAX_UPLOAD_MB=5
